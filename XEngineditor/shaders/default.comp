#version 460 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform writeonly image2D screenTexture;

// SSBO 相關定義 (保持不變)
struct OBVHNode {
    vec4 aabbMin;
    vec4 aabbMax;
    ivec4 childrenA; // 最多4個子節點索引，-1表示無
    ivec4 childrenB; // 最多4個子節點索引，-1表示無
    ivec4 info;     // z=start, w=count
};

struct Camera {
    vec3 position;
    vec3 lookat;
    vec3 up;
    float fov;
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Material {
    int type;        // 材質類型，例如 DIFFUSE, GLASS, LIGHT
    float roughness; // 粗糙度（可選）
    float ior;       // 折射率（可選，玻璃用）
};

struct HitRecord {
    vec3 pos;
    vec3 color;
    Material material;
    float t;
    vec3 shadingNormal; 
    vec3 geoNormal;     
};

layout(std430, binding = 1) buffer OBVHNodeBuffer {
    OBVHNode obvhNodes[];
};

layout(std430, binding = 2) buffer VerticesBuffer {
    vec4 vertices[];
};

layout(std430, binding = 3) buffer IndicesBuffer {
    ivec4 indices[];
};

layout(std430, binding = 4) buffer FaceNormalsBuffer {
    vec4 faceNormals[];
};

layout(std430, binding = 5) buffer TexCoordsBuffer {
    vec2 texCoords[];
};

layout(std430, binding = 7) buffer MaterialIndicesBuffer {
    int materialIndices[];
};

layout(std430, binding = 8) buffer MatToTexMapBuffer {
    int matToTexMap[];
};

layout(std430, binding = 9) buffer VertexNormalsBuffer {
    vec4 vertexNormals[];
};




layout(binding = 10) uniform sampler2D u_textures[16]; 


uniform vec2 u_resolution; 
uniform Camera camera;
uniform mat4 invViewProj;
uniform int max_depth;
uniform vec3 backgroundColor;

const float EPSILON = 1e-4;
const vec3 WHITE = vec3(1.0, 1.0, 1.0);

// 定義隨機數生成函數
uint hash( uint x ) {
    x += ( x << 10u );
    x ^= ( x >>  6u );
    x += ( x <<  3u );
    x ^= ( x >> 11u );
    x += ( x << 15u );
    return x;
}

uint hash( uvec2 v ) { return hash( v.x ^ hash(v.y)                         ); }
uint hash( uvec3 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z)             ); }
uint hash( uvec4 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z) ^ hash(v.w) ); }

float floatConstruct( uint m ) {
    const uint ieeeMantissa = 0x007FFFFFu;
    const uint ieeeOne      = 0x3F800000u;

    m &= ieeeMantissa;
    m |= ieeeOne;

    float  f = uintBitsToFloat( m );
    return f - 1.0;
}

float random( float x ) { return floatConstruct(hash(floatBitsToUint(x))); }
float random( vec2  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec3  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec4  v ) { return floatConstruct(hash(floatBitsToUint(v))); }

vec2 random_vec2(vec2 p) {
    return vec2(random(p), random(p + vec2(1.0, 0.0)));
}

vec3 random_color(vec2 co) {
    return vec3(random(co + vec2(1.0, 0.0)),
                random(co + vec2(0.0, 1.0)),
                random(co + vec2(1.0, 1.0)));
}

vec3 random_unit_vector(vec2 co) {
    float z = random(co) * 2.0 - 1.0; // z in [-1, 1]
    float t = random(co + vec2(1.0, 1.0)) * 6.28318530718; // t in [0, 2π]
    float r = sqrt(1.0 - z * z); // radius at z
    return normalize(vec3(r * cos(t), r * sin(t), z));
}

vec3 random_in_hemisphere(vec3 normal, vec2 seed) {
    vec3 in_unit = random_unit_vector(seed);
    return dot(in_unit, normal) > 0.0 ? in_unit : -in_unit;
}


// ------------------------------------------------
// 材質類型常數
const int TEXTURE = -1;
const int LIGHT = 0;
const int DIFFUSE = 1;
const int GLASS = 2;

// 取得材質屬性函式
Material getMaterial(int material) {
    Material mat;
    if (material == LIGHT) {
        mat.type = LIGHT;
    } else if (material == DIFFUSE) {
        mat.type = DIFFUSE;
        mat.roughness = 0.5;
    } else if (material == GLASS) {
        mat.type = GLASS;
        mat.ior = 1.5;
    } else {
        mat.type = DIFFUSE;
        mat.roughness = 0.5;
    }
    return mat;
}

vec3 refract(vec3 I, vec3 N, float eta) {
    // 反射向量計算
    float cosI = dot(-I, N);
    float sinT2 = eta * eta * (1.0 - cosI * cosI);
    if (sinT2 > 1.0) return reflect(I, N); // 全反射
    float cosT = sqrt(1.0 - sinT2);
    return eta * I + (eta * cosI - cosT) * N;
}
// ------------------------------------------------
// 計算光線衰減函式
float calculateAttenuation(float dist) {
    // 調整衰減參數，讓光線衰減更慢
    float constant = 1.0;
    float linear = 0.02;     // 原本 0.09，改小
    float quadratic = 0.005; // 原本 0.032，改小
    return 1.0 / (constant + linear * dist + quadratic * dist * dist);
}

// --- 新增 rayTriangleIntersect 函式 (你的版本) ---
vec3 rayTriangleIntersect(Ray ray, vec3 p0, vec3 p1, vec3 p2) {
    vec3 edge1 = p1 - p0;
    vec3 edge2 = p2 - p0;
    vec3 pvec = cross(ray.direction, edge2);
    float det = dot(edge1, pvec);

    if (abs(det) < EPSILON) {
        return vec3(-1.0); 
    }

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - p0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) {
        return vec3(-1.0);
    }

    vec3 qvec = cross(tvec, edge1);
    float v = dot(ray.direction, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) {
        return vec3(-1.0);
    }

    float t = dot(edge2, qvec) * invDet;
    return vec3(t, u, v);
}
// ------------------------------------------------
// --- 新增 hit_qbvh 函式 ---
bool aabb_hit(Ray ray, vec3 minB, vec3 maxB, float tMax) {
    vec3 invD = 1.0 / ray.direction;
    vec3 t0s = (minB - ray.origin) * invD;
    vec3 t1s = (maxB - ray.origin) * invD;
    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);
    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);
    return tmax >= max(tmin, 0.0) && tmin < tMax;
}



bool hit_obvh(Ray ray, inout HitRecord rec) {
    bool hitSomething = false;
    vec3 tempColor;
    vec3 tempShadingNormal, tempGeoNormal;
    Material tempMaterial;

    int stack[16];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // root node

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        OBVHNode node = obvhNodes[nodeIdx];

        // 1. AABB 測試，提前剪裁
        if (!aabb_hit(ray, node.aabbMin.xyz, node.aabbMax.xyz, rec.t)) {
            continue;
        }

        // 2. 判斷是葉節點還是內部節點 (假設 info.w > 0 代表葉節點)
        bool isLeaf = (node.info.w > 0);

        if (isLeaf) {
            // 處理葉節點中的所有三角形
            int start = node.info.z;
            int count = node.info.w;
            for (int i = start; i < start + count; i++) {
                ivec4 index = indices[i];
                vec3 p0 = vertices[index.x].xyz;
                vec3 p1 = vertices[index.y].xyz;
                vec3 p2 = vertices[index.z].xyz;
                int material_id = index.w;
                vec3 normal = faceNormals[i].xyz;

                vec3 intersection = rayTriangleIntersect(ray, p0, p1, p2);
                float t = intersection.x;
                float u = intersection.y;
                float v = intersection.z;

                // 如果找到更近的擊中點
                if (t > 0.0 && t < rec.t) {
                    hitSomething = true;
                    rec.t = t;

                    tempMaterial = getMaterial(material_id);
                    
                    // --- 法線計算 ---
                    // 1. 幾何法線 (從面法線緩衝區讀取)
                    tempGeoNormal = faceNormals[i].xyz;

                    // 2. 着色法線 (通過插值頂點法線得到)
                    vec3 n0 = vertexNormals[index.x].xyz;
                    vec3 n1 = vertexNormals[index.y].xyz;
                    vec3 n2 = vertexNormals[index.z].xyz;
                    // 使用重心座標 (1-u-v, u, v) 進行插值
                    tempShadingNormal = normalize((1.0 - u - v) * n0 + u * n1 + v * n2);

                    // 根據材質類型計算顏色
                    if (material_id == LIGHT) {
                        tempColor = vec3(10.0); // 光源發光顏色
                    } else if (material_id == TEXTURE) {
                        int matIndex = materialIndices[i];
                        int textureIndex = (matIndex >= 0) ? matToTexMap[matIndex] : -1;

                        if (textureIndex >= 0) {
                            vec2 uv0 = texCoords[index.x];
                            vec2 uv1 = texCoords[index.y];
                            vec2 uv2 = texCoords[index.z];
                            vec2 hitUV = (1.0 - u - v) * uv0 + u * uv1 + v * uv2;
                            tempColor = texture(u_textures[textureIndex], hitUV).rgb;
                        } else {
                            tempColor = vec3(0.8, 0.8, 0.8); // 有材質但無紋理，顯示灰色
                        }
                    } else { // DIFFUSE, GLASS, 或其他無紋理的材質
                        tempColor = vec3(0.7, 0.7, 0.7); // 預設基礎顏色
                    }
                }
            }
        } else {
            // 處理內部節點，將子節點壓入堆疊
            // 這裡的 OBVH 是 8-ary tree (八叉樹)
            ivec4 childrenA = node.childrenA;
            ivec4 childrenB = node.childrenB;
            if (childrenA.x >= 0) stack[stackPtr++] = childrenA.x;
            if (childrenA.y >= 0) stack[stackPtr++] = childrenA.y;
            if (childrenA.z >= 0) stack[stackPtr++] = childrenA.z;
            if (childrenA.w >= 0) stack[stackPtr++] = childrenA.w;
            if (childrenB.x >= 0) stack[stackPtr++] = childrenB.x;
            if (childrenB.y >= 0) stack[stackPtr++] = childrenB.y;
            if (childrenB.z >= 0) stack[stackPtr++] = childrenB.z;
            if (childrenB.w >= 0) stack[stackPtr++] = childrenB.w;
        }
    }

    // 如果整個遍歷過程中有找到擊中點，更新最終的 HitRecord
    if (hitSomething) {
        rec.pos = ray.origin + rec.t * ray.direction;
        rec.shadingNormal = tempShadingNormal; // 儲存着色法線
        rec.geoNormal = tempGeoNormal;         // 儲存幾何法線
        rec.material = tempMaterial;
        rec.color = tempColor;
        return true;
    }
    
    return false;
}

bool hit_world(Ray ray, out HitRecord rec) {
    rec.t = 1e9;
    bool hitSomething = false;
    vec3 tempColor = vec3(0.0);
    vec3 tempNormal = vec3(0.0);
    Material tempMaterial;

    HitRecord triRec;
    triRec.t = rec.t;
    if (hit_obvh(ray, triRec)) {
        rec = triRec; // 直接複製整個 HitRecord
