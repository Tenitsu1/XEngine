#version 460 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform writeonly image2D screenTexture;

// SSBO 相關定義 (保持不變)
struct OBVHNode {
    vec4 aabbMin;
    vec4 aabbMax;
    ivec4 childrenA; // 最多4個子節點索引，-1表示無
    ivec4 childrenB; // 最多4個子節點索引，-1表示無
    ivec4 info;     // z=start, w=count
};

struct Camera {
    vec3 position;
    vec3 lookat;
    vec3 up;
    float fov;
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Material {
    int type;        // 材質類型，例如 DIFFUSE, GLASS, LIGHT
    float roughness; // 粗糙度（可選）
    float ior;       // 折射率（可選，玻璃用）
};

struct HitRecord {
    vec3 pos;
    vec3 normal;
    vec3 color;
    Material material;
    float t;
};

layout(std430, binding = 1) buffer OBVHNodeBuffer {
    OBVHNode obvhNodes[];
};

layout(std430, binding = 2) buffer VerticesBuffer {
    vec4 vertices[];
};

layout(std430, binding = 3) buffer IndicesBuffer {
    ivec4 indices[];
};

layout(std430, binding = 4) buffer NormalsBuffer {
    vec4 normals[];
};

layout(std430, binding = 5) buffer TexCoordsBuffer {
    vec2 texCoords[];
};


layout(std430, binding = 7) buffer MaterialIndicesBuffer {
    int materialIndices[];
};

layout(std430, binding = 8) buffer MatToTexMapBuffer {
    int matToTexMap[];
};

layout(binding = 10) uniform sampler2D u_textures[32]; 


uniform vec2 u_resolution; 
uniform Camera camera;
uniform mat4 invViewProj;
uniform int max_depth;
uniform vec3 backgroundColor;

const float EPSILON = 1e-4;
const vec3 WHITE = vec3(1.0, 1.0, 1.0);

// 定義隨機數生成函數
uint hash( uint x ) {
    x += ( x << 10u );
    x ^= ( x >>  6u );
    x += ( x <<  3u );
    x ^= ( x >> 11u );
    x += ( x << 15u );
    return x;
}

uint hash( uvec2 v ) { return hash( v.x ^ hash(v.y)                         ); }
uint hash( uvec3 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z)             ); }
uint hash( uvec4 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z) ^ hash(v.w) ); }

float floatConstruct( uint m ) {
    const uint ieeeMantissa = 0x007FFFFFu;
    const uint ieeeOne      = 0x3F800000u;

    m &= ieeeMantissa;
    m |= ieeeOne;

    float  f = uintBitsToFloat( m );
    return f - 1.0;
}

float random( float x ) { return floatConstruct(hash(floatBitsToUint(x))); }
float random( vec2  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec3  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec4  v ) { return floatConstruct(hash(floatBitsToUint(v))); }

vec2 random_vec2(vec2 p) {
    return vec2(random(p), random(p + vec2(1.0, 0.0)));
}

vec3 random_color(vec2 co) {
    return vec3(random(co + vec2(1.0, 0.0)),
                random(co + vec2(0.0, 1.0)),
                random(co + vec2(1.0, 1.0)));
}

vec3 random_unit_vector(vec2 co) {
    float z = random(co) * 2.0 - 1.0; // z in [-1, 1]
    float t = random(co + vec2(1.0, 1.0)) * 6.28318530718; // t in [0, 2π]
    float r = sqrt(1.0 - z * z); // radius at z
    return normalize(vec3(r * cos(t), r * sin(t), z));
}

vec3 random_in_hemisphere(vec3 normal, vec2 seed) {
    vec3 in_unit = random_unit_vector(seed);
    return dot(in_unit, normal) > 0.0 ? in_unit : -in_unit;
}


// ------------------------------------------------
// 材質類型常數
const int TEXTURE = -1;
const int LIGHT = 0;
const int DIFFUSE = 1;
const int GLASS = 2;

// 取得材質屬性函式
Material getMaterial(int material) {
    Material mat;
    if (material == LIGHT) {
        mat.type = LIGHT;
    } else if (material == DIFFUSE) {
        mat.type = DIFFUSE;
        mat.roughness = 0.5;
    } else if (material == GLASS) {
        mat.type = GLASS;
        mat.ior = 1.5;
    } else {
        mat.type = DIFFUSE;
        mat.roughness = 0.5;
    }
    return mat;
}

vec3 refract(vec3 I, vec3 N, float eta) {
    // 反射向量計算
    float cosI = dot(-I, N);
    float sinT2 = eta * eta * (1.0 - cosI * cosI);
    if (sinT2 > 1.0) return reflect(I, N); // 全反射
    float cosT = sqrt(1.0 - sinT2);
    return eta * I + (eta * cosI - cosT) * N;
}
// ------------------------------------------------
// 計算光線衰減函式
float calculateAttenuation(float dist) {
    // 調整衰減參數，讓光線衰減更慢
    float constant = 1.0;
    float linear = 0.02;     // 原本 0.09，改小
    float quadratic = 0.005; // 原本 0.032，改小
    return 1.0 / (constant + linear * dist + quadratic * dist * dist);
}

// --- 新增 rayTriangleIntersect 函式 (你的版本) ---
vec3 rayTriangleIntersect(Ray ray, vec3 p0, vec3 p1, vec3 p2) {
    vec3 edge1 = p1 - p0;
    vec3 edge2 = p2 - p0;
    vec3 pvec = cross(ray.direction, edge2);
    float det = dot(edge1, pvec);

    if (abs(det) < EPSILON) {
        return vec3(-1.0); 
    }

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - p0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) {
        return vec3(-1.0);
    }

    vec3 qvec = cross(tvec, edge1);
    float v = dot(ray.direction, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) {
        return vec3(-1.0);
    }

    float t = dot(edge2, qvec) * invDet;
    return vec3(t, u, v);
}
// ------------------------------------------------
// --- 新增 hit_qbvh 函式 ---
bool aabb_hit(Ray ray, vec3 minB, vec3 maxB, float tMax) {
    vec3 invD = 1.0 / ray.direction;
    vec3 t0s = (minB - ray.origin) * invD;
    vec3 t1s = (maxB - ray.origin) * invD;
    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger = max(t0s, t1s);
    float tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    float tmax = min(min(tbigger.x, tbigger.y), tbigger.z);
    return tmax >= max(tmin, 0.0) && tmin < tMax;
}

bool hit_obvh(Ray ray, inout HitRecord rec) {
    bool hitSomething = false;
    vec3 tempColor = vec3(0.0);
    vec3 tempNormal = vec3(0.0);
    Material tempMaterial;

    int stack[256];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // root node

    while (stackPtr > 0) 
    {
        int nodeIdx = stack[--stackPtr];
        OBVHNode node = obvhNodes[nodeIdx];
        if (!aabb_hit(ray, node.aabbMin.xyz, node.aabbMax.xyz, rec.t)) continue;

        ivec4 childrenA = node.childrenA;
        ivec4 childrenB = node.childrenB;
        int start = node.info.z;
        int count = node.info.w;
        bool isLeaf = (childrenA.x < 0 && childrenA.y < 0 && childrenA.z < 0 &&
                       childrenB.x < 0 && childrenB.y < 0 && childrenB.z < 0);
        if (isLeaf) 
        {
            for (int i = start; i < start + count; i++) 
            {  
                ivec4 index = indices[i];
                vec3 p0 = vertices[index.x].xyz;
                vec3 p1 = vertices[index.y].xyz;
                vec3 p2 = vertices[index.z].xyz;
                // int material = GLASS;
                // int material = DIFFUSE;
                int material = index.w;
                vec3 normal = normals[i].xyz;

                vec3 intersection = rayTriangleIntersect(ray, p0, p1, p2);
                float t = intersection.x;
                float u = intersection.y;
                float v = intersection.z;

                if (t > 0.0 && t < rec.t) 
                {
                    rec.t = t;
                    hitSomething = true;

                    // [修改] 內插法線以獲得平滑著色
                    //vec3 n0 = normals[index.x].xyz;
                    //vec3 n1 = normals[index.y].xyz;
                    //vec3 n2 = normals[index.z].xyz;
                    // 使用重心座標 (1-u-v, u, v) 進行內插
                    //tempNormal = normalize((1.0 - u - v) * n0 + u * n1 + v * n2);
                    tempNormal = normal;
                    tempMaterial = getMaterial(material);
                    if (material == LIGHT) 
                    {
                        tempColor = vec3(10.0); // 光源顏色為白色
                        continue; // 光源不需要紋理採樣
                    } 
                    else if (material == TEXTURE) 
                    {
                        // 從 SSBO 中獲取當前Mesh的材質索引
                        int matIndex = materialIndices[i]; 

                        int textureIndex = -1; // 默認為-1 (無紋理)

                        if (matIndex >= 0) 
                        {
                            textureIndex = matToTexMap[matIndex];

                            if (textureIndex >= 0) 
                            {
                                // [修改] 內插 UV 座標並從紋理採樣
                                vec2 uv0 = texCoords[index.x];
                                vec2 uv1 = texCoords[index.y];
                                vec2 uv2 = texCoords[index.z];
                                vec2 hitUV = (1.0 - u - v) * uv0 + u * uv1 + v * uv2;

                                // 從紋理採樣顏色
                                tempColor = texture(u_textures[textureIndex], hitUV).rgb;
                            }
                            else
                            {
                                // 材質存在，但沒有紋理，紫色
                                tempColor = vec3(1.0, 0.0, 1.0);
                            }
                        }
                        else 
                        {
                            // 沒有材質，給默認灰色
                            tempColor = vec3(0.5, 0.5, 0.5);
                        }
                    }
                }
            }
        } 
        else 
        {
            for (int i = 0; i < 4; i++) 
            {
                int childA = childrenA[i];
                int childB = childrenB[i];
                if (childA >= 0) stack[stackPtr++] = childA;
                if (childB >= 0) stack[stackPtr++] = childB;
            }
        }
    }

    if (hitSomething) 
    {
        rec.pos = ray.origin + rec.t * ray.direction;
        rec.normal = tempNormal;
        rec.material = tempMaterial;
        rec.color = tempColor;
        return true;
    }
    return false;
}

bool hit_world(Ray ray, out HitRecord rec) {
    rec.t = 1e9;
    bool hitSomething = false;
    vec3 tempColor = vec3(0.0);
    vec3 tempNormal = vec3(0.0);
    Material tempMaterial;

    HitRecord triRec;
    triRec.t = rec.t;
    if (hit_obvh(ray, triRec)) {
        if (triRec.t < rec.t) {
            rec.t = triRec.t;
            hitSomething = true;
            tempNormal = triRec.normal;
            tempColor = triRec.color;
            tempMaterial = triRec.material;

        }
    }

    if (!hitSomething) {
        return false;
    }

    rec.pos = ray.origin + rec.t * ray.direction;
    rec.normal = tempNormal;
    rec.color = tempColor;
    rec.material = tempMaterial;
    return true;
}

vec3 getRayDir(vec2 pixel)
{
    // 光線生成
    vec2 ndc = (pixel + vec2(0.5)) / u_resolution * 2.0 - 1.0; // 正規化裝置座標
    vec4 clip = vec4(ndc, -1.0, 1.0);   // 裁剪空間座標
    vec4 eye = invViewProj * clip;      // 轉換到相機空間
    eye /= eye.w;                       // 齊次坐標歸一化
    return normalize(eye.xyz - camera.position);
}
// ----------------------------------------------------
const int SAMPLES_PER_PIXEL = 1;
void main()
{
    // 取得像素座標
    vec2 pixel = gl_GlobalInvocationID.xy;
    // 邊界檢查
    if (pixel.x >= u_resolution.x || pixel.y >= u_resolution.y) return;
    
    vec3 color = vec3(0.0);
    
    for (int s = 0; s < SAMPLES_PER_PIXEL; ++s) {
        // 隨機偏移像素座標
        vec2 jitter = random_vec2(pixel + float(s)) - 0.5;
        vec2 samplePixel = pixel + jitter;

        Ray ray;
        ray.origin = camera.position;
        ray.direction = getRayDir(samplePixel);

        vec3 attenuation = WHITE;
        float t = 0.0;
        for (int depth = 0; depth < 10; depth++) {
            HitRecord rec;
            if (!hit_world(ray, rec)) {
                color += attenuation;
                break;
            }
            t += rec.t;

            if (rec.material.type == LIGHT) {
                float lightAttenuation = calculateAttenuation(t);
                color += attenuation * rec.color * lightAttenuation;
                // color += attenuation * rec.color;
                break;
            } else if (rec.material.type == GLASS) {
                float ior = rec.material.ior;
                float eta = dot(ray.direction, rec.normal) < 0.0 ? (1.0 / ior) : ior;
                ray.direction = refract(ray.direction, rec.normal, eta);
                attenuation *= max(vec3(0.8), rec.color) * 0.98;
            } else {
                vec3 diffuseDir = random_in_hemisphere(rec.normal, rec.pos.xy + float(depth) + float(s));
                vec3 specularDir = reflect(ray.direction, rec.normal);
                ray.direction = normalize(mix(diffuseDir, specularDir, rec.material.roughness));
                attenuation *= rec.color * 0.8;
            }
            ray.origin = rec.pos + ray.direction * EPSILON;
        }
        // // 背景顏色 (天空盒)
        // float a = 0.5 * (ray.direction.y + 1.0);
        // vec3 BLUE = vec3(0.5, 0.7, 1.0);
        // vec3 sky = mix(WHITE, BLUE, a);
        // color += attenuation * sky;
    }
    color /= float(SAMPLES_PER_PIXEL); // 平均多重採樣結果
    imageStore(screenTexture, ivec2(pixel), vec4(color, 1.0));
}