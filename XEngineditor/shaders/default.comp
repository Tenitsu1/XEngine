#version 460 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform writeonly image2D screenTexture;

// SSBO 相關定義 (保持不變)
struct OBVHNode {
    vec4 aabbMin;
    vec4 aabbMax;
    ivec4 top; // 最多4個子節點索引，-1表示無
    ivec4 bottom; // 最多4個子節點索引，-1表示無
    ivec4 info;     // z=start, w=count
};

struct Camera {
    vec3 position;
    vec3 lookat;
    vec3 up;
    float fov;
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Material {
    int type;                       // 材質類型
    vec3 baseColor;                 // 基础颜色因子
    int baseColorTexture;           // 基础颜色贴图
    int metallic;                   // 金属度因子
    float roughness;                // 粗糙度因子
    int metallicRoughnessTexture;   // 金属度-粗糙度贴图
    int normalTexture;              // 法线贴图
    float transmission;             // 透射率
    float ior;                      // 折射率
};

struct HitRecord {
    vec3 point;
    vec3 color;
    Material material;
    float t;
    vec3 shadingNormal; 
    vec3 geoNormal;     
};

layout(std430, binding = 1) buffer OBVHNodeBuffer {
    OBVHNode obvhNodes[];
};

layout(std430, binding = 2) buffer VerticesBuffer {
    vec4 vertices[];
};

layout(std430, binding = 3) buffer IndicesBuffer {
    ivec4 indices[];
};

layout(std430, binding = 4) buffer GeoNormalsBuffer {
    vec4 geoNormals[];
};

layout(std430, binding = 5) buffer TexCoordsBuffer {
    vec2 texCoords[];
};

layout(std430, binding = 7) buffer MaterialIndicesBuffer {
    int materialIndices[];
};

layout(std430, binding = 8) buffer MatToTexMapBuffer {
    int matToTexMap[];
};

layout(std430, binding = 9) buffer VertexNormalsBuffer {
    vec4 vertexNormals[];
};




layout(binding = 10) uniform sampler2D u_textures[16]; 


uniform vec2 u_resolution; 
uniform Camera camera;
uniform mat4 invViewProj;
uniform int max_depth;
uniform vec3 backgroundColor;
uniform bool useOBVH;

const float EPSILON = 1e-4;
const vec3 WHITE = vec3(1.0, 1.0, 1.0);

// 定義隨機數生成函數
uint hash( uint x ) {
    x += ( x << 10u );
    x ^= ( x >>  6u );
    x += ( x <<  3u );
    x ^= ( x >> 11u );
    x += ( x << 15u );
    return x;
}

uint hash( uvec2 v ) { return hash( v.x ^ hash(v.y)                         ); }
uint hash( uvec3 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z)             ); }
uint hash( uvec4 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z) ^ hash(v.w) ); }

float floatConstruct( uint m ) {
    const uint ieeeMantissa = 0x007FFFFFu;
    const uint ieeeOne      = 0x3F800000u;

    m &= ieeeMantissa;
    m |= ieeeOne;

    float  f = uintBitsToFloat( m );
    return f - 1.0;
}

float random( float x ) { return floatConstruct(hash(floatBitsToUint(x))); }
float random( vec2  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec3  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec4  v ) { return floatConstruct(hash(floatBitsToUint(v))); }

vec2 random_vec2(vec2 p) {
    return vec2(random(p), random(p + vec2(1.0, 0.0)));
}

vec3 random_color(vec2 co) {
    return vec3(random(co + vec2(1.0, 0.0)),
                random(co + vec2(0.0, 1.0)),
                random(co + vec2(1.0, 1.0)));
}

vec3 random_unit_vector(vec2 co) {
    float z = random(co) * 2.0 - 1.0; // z in [-1, 1]
    float t = random(co + vec2(1.0, 1.0)) * 6.28318530718; // t in [0, 2π]
    float r = sqrt(1.0 - z * z); // radius at z
    return normalize(vec3(r * cos(t), r * sin(t), z));
}

vec3 random_in_hemisphere(vec3 normal, vec2 seed) {
    vec3 in_unit = random_unit_vector(seed);
    return dot(in_unit, normal) > 0.0 ? in_unit : -in_unit;
}

vec3 cosine_weighted_direction(vec3 normal, vec2 seed, vec3 geoNormal) {
    // 餘弦加權分布
    vec2 r = random_vec2(seed);
    float phi = 2.0 * 3.14159265359 * r.x;
    float cosTheta = sqrt(1.0 - r.y);
    float sinTheta = sqrt(r.y);

    vec3 tangent = normalize(abs(normal.x) > 0.1 ? cross(normal, vec3(0,1,0)) : cross(normal, vec3(1,0,0)));
    vec3 bitangent = cross(normal, tangent);

    vec3 dir = cosTheta * normal +
               sinTheta * cos(phi) * tangent +
               sinTheta * sin(phi) * bitangent;
    dir = normalize(dir);

    return dot(dir, geoNormal) < 0.0 ? -dir : dir;
}

// GGX D項：Normal Distribution Function
float D_GGX(float NdotH, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float NdotH2 = NdotH * NdotH;
    float denom = NdotH2 * (a2 - 1.0) + 1.0;
    return a2 / (3.14159265 * denom * denom);
}

// GGX G項：Geometry/Shadowing Term（Smith法）
float G_Smith(float NdotV, float NdotL, float roughness) {
    float a = roughness * roughness;
    float k = (a + 1.0) * (a + 1.0) / 8.0;
    float G1V = NdotV / (NdotV * (1.0 - k) + k);
    float G1L = NdotL / (NdotL * (1.0 - k) + k);
    return G1V * G1L;
}

// F項：Schlick近似的Fresnel
vec3 F_Schlick(float VdotH, vec3 F0) {
    return F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
}

// GGX Specular BRDF
vec3 GGX_Specular(vec3 normal, vec3 viewDir, vec3 lightDir, float roughness, vec3 F0) {
    vec3 halfDir = normalize(viewDir + lightDir);
    float NdotL = max(dot(normal, lightDir), 0.0);
    float NdotV = max(dot(normal, viewDir), 0.0);
    float NdotH = max(dot(normal, halfDir), 0.0);
    float VdotH = max(dot(viewDir, halfDir), 0.0);

    float D = D_GGX(NdotH, roughness);
    float G = G_Smith(NdotV, NdotL, roughness);
    vec3 F = F_Schlick(VdotH, F0);

    return (D * G * F) / (4.0 * NdotL * NdotV + 0.001);
}

// 區域光源採樣函式
vec3 sample_area_light(vec3 lightCenter, float lightRadius, vec2 seed) {
    float z = random(seed) * 2.0 - 1.0;
    float phi = 2.0 * 3.14159265359 * random(seed + 1.0);
    float r = sqrt(1.0 - z * z);
    vec3 dir = vec3(r * cos(phi), r * sin(phi), z);
    return lightCenter + lightRadius * dir;
}

// ------------------------------------------------
// 材質類型常數
const int TEXTURE = -1;
const int LIGHT = 0;
const int DIFFUSE = 1;
const int GLASS = 2;
const int METAL = 3;

// 取得材質屬性函式
Material getMaterial(int material) {
    Material mat;
    if (material == LIGHT) {
        mat.type = LIGHT;
    } else if (material == DIFFUSE) {
        mat.type = DIFFUSE;
        mat.roughness = 0.8;
    } else if (material == GLASS) {
        mat.type = GLASS;
        mat.ior = 1.5;
    } else if (material == METAL) {
        mat.type = METAL;
        mat.roughness = 0.2;
    } else {
        mat.type = DIFFUSE;
        mat.roughness = 0.8;
    }
    return mat;
}

// ------------------------------------------------
// 計算光線衰減函式
float calculateAttenuation(float dist) {
    // 調整衰減參數，讓光線衰減更慢
    float constant = 1.0;
    float linear = 0.02;     // 原本 0.09，改小
    float quadratic = 0.005; // 原本 0.032，改小
    return 1.0 / (constant + linear * dist + quadratic * dist * dist);
}

// --- 新增 intersectTriangle 函式 (你的版本) ---
vec3 intersectTriangle(Ray ray, vec3 p0, vec3 p1, vec3 p2) {
    vec3 edge1 = p1 - p0;
    vec3 edge2 = p2 - p0;
    vec3 pvec = cross(ray.direction, edge2);
    float det = dot(edge1, pvec);

    if (abs(det) < EPSILON) return vec3(-1.0);

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - p0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return vec3(-1.0);

    vec3 qvec = cross(tvec, edge1);
    float v = dot(ray.direction, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) return vec3(-1.0);

    float t = dot(edge2, qvec) * invDet;

    if (t < EPSILON) return vec3(-1.0);
    return vec3(t, u, v);
}
// ------------------------------------------------
// --- 新增 hit_qbvh 函式 ---
bool aabb_hit(Ray ray, vec3 minB, vec3 maxB, float tMax) {
    vec3 invD = 1.0 / ray.direction;
    vec3 t0 = (minB - ray.origin) * invD;
    vec3 t1 = (maxB - ray.origin) * invD;

    vec3 tmin = min(t0, t1);
    vec3 tmax = max(t0, t1);

    float entry = max(max(tmin.x, tmin.y), tmin.z);
    float exit  = min(min(tmax.x, tmax.y), tmax.z);

    return exit >= max(entry, 0.0) && entry < tMax;
}

vec3 get_texture_color(int i, float u, float v) {
    // 從 SSBO 中獲取當前Mesh的材質索引
    int matIndex = materialIndices[i];
    if (matIndex < 0) {
        return vec3(0.5, 0.5, 0.5); // 灰色表示無材質
    }

    // 從材質索引映射到紋理索引
    int textureIndex = matToTexMap[matIndex];
    if (textureIndex < 0) {
        return vec3(1.0, 0.0, 1.0); // 紫色表示沒有紋理
    }

    ivec4 index = indices[i];
    vec2 uv0 = texCoords[index.x];
    vec2 uv1 = texCoords[index.y];
    vec2 uv2 = texCoords[index.z];

    // 內插 UV 座標並從紋理採樣
    vec2 hitUV = (1.0 - u - v) * uv0 + u * uv1 + v * uv2;

    return texture(u_textures[textureIndex], hitUV).rgb;
}

bool hit_obvh_leaf(Ray ray, int i, inout float tMax, out vec3 hitResult) {
    bool doubleSided = false;
    ivec4 index = indices[i];
    vec3 p0 = vertices[index.x].xyz;
    vec3 p1 = vertices[index.y].xyz;
    vec3 p2 = vertices[index.z].xyz;

    vec3 tempHitResult = intersectTriangle(ray, p0, p1, p2);
    float t = tempHitResult.x;

    bool hitSomething = t < tMax && (doubleSided || t > EPSILON);
    if (hitSomething) {
        tMax = t;
        hitResult = tempHitResult;
        return true;
    } else {
        return false;
    }
}

int hit_obvh(Ray ray, out vec3 hitResult) {
    float tMax = 1e9;
    int hitIdx = -1;

    int stack[64];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // root node

    while (stackPtr > 0) {
        int nodeIdx = stack[--stackPtr];
        OBVHNode node = obvhNodes[nodeIdx];

        if (!aabb_hit(ray, node.aabbMin.xyz, node.aabbMax.xyz, tMax)) {
            continue;
        }

        bool isLeaf = (node.info.x == 1);

        if (isLeaf) {
            // 處理葉節點中的所有三角形
            int start = node.info.z;
            int count = node.info.w;
            for (int i = start; i < start + count; i++) 
            {   
                vec3 tempHitResult;
                if (hit_obvh_leaf(ray, i, tMax, tempHitResult)) 
                {
                    hitIdx = i;
                    hitResult = tempHitResult;
                }
            }
        } else {
            ivec4 top = node.top;
            ivec4 bottom = node.bottom;
            if (top.x >= 0) stack[stackPtr++] = top.x;
            if (top.y >= 0) stack[stackPtr++] = top.y;
            if (top.z >= 0) stack[stackPtr++] = top.z;
            if (top.w >= 0) stack[stackPtr++] = top.w;
            if (bottom.x >= 0) stack[stackPtr++] = bottom.x;
            if (bottom.y >= 0) stack[stackPtr++] = bottom.y;
            if (bottom.z >= 0) stack[stackPtr++] = bottom.z;
            if (bottom.w >= 0) stack[stackPtr++] = bottom.w;
        }
    }
    return hitIdx;
}

int hit_triangle(Ray ray, out vec3 hitResult) {
    float tMax = 1e9;
    int hitIdx = -1;

    for (int i = 0; i < indices.length(); i++) {
        ivec4 index = indices[i];
        vec3 p0 = vertices[index.x].xyz;
        vec3 p1 = vertices[index.y].xyz;
        vec3 p2 = vertices[index.z].xyz;

        vec3 tempHitResult = intersectTriangle(ray, p0, p1, p2);
        float t = tempHitResult.x;

        if (t < tMax && t > EPSILON) {
            tMax = t;
            hitIdx = i;
            hitResult = tempHitResult;
        }
    }
    return hitIdx;
}

vec3 quadratic_normal(vec3 n0, vec3 n1, vec3 n2, float u, float v) {
    float w = 1.0 - u - v;
    // 二次重心基底
    float uu = u * u;
    float vv = v * v;
    float ww = w * w;
    float uv = u * v;
    float uw = u * w;
    float vw = v * w;
    // 可調整權重，這裡用常見的二次重心插值
    return normalize(
        n0 * ww +
        n1 * uu +
        n2 * vv +
        2.0 * (n0 * uw + n1 * uv + n2 * vw)
    );
}

bool hit_world(Ray ray, out HitRecord hit) {
    vec3 hitResult;
    int hitIdx = useOBVH ? hit_obvh(ray, hitResult) : hit_triangle(ray, hitResult);
    if (hitIdx == -1) return false;

    ivec4 index = indices[hitIdx];
    vec3 p0 = vertices[index.x].xyz;
    vec3 p1 = vertices[index.y].xyz;
    vec3 p2 = vertices[index.z].xyz;
    
    float t = hitResult.x;
    float u = hitResult.y;
    float v = hitResult.z;

    hit.t = t;
    hit.point = ray.origin + hit.t * ray.direction;

    vec3 n0 = vertexNormals[index.x].xyz;
    vec3 n1 = vertexNormals[index.y].xyz;
    vec3 n2 = vertexNormals[index.z].xyz;

    vec3 geoNormal = geoNormals[hitIdx].xyz;
    // vec3 normal = quadratic_normal(n0, n1, n2, u, v);
    vec3 normal = normalize((1.0 - u - v) * n0 + u * n1 + v * n2);
    bool geo_frontFace = dot(ray.direction, geoNormal) < 0.0;
    bool frontFace = dot(geoNormal, normal) > 0.0;

    hit.geoNormal = geo_frontFace ? geoNormal : -geoNormal;
    hit.shadingNormal = frontFace ? normal : -normal;

    int material = index.w;
    hit.material = getMaterial(material);
    if (material == LIGHT) 
    {
        hit.color = vec3(15.0); // 光源顏色為白色
        return true;
    }

    if (material == TEXTURE) 
    {
        // 從紋理採樣顏色
        hit.color = get_texture_color(hitIdx, u, v);
        return true;
    }
    return true;
}

vec3 getRayDir(vec2 pixel)
{
    // 光線生成
    vec2 ndc = (pixel + vec2(0.5)) / u_resolution * 2.0 - 1.0; // 正規化裝置座標
    vec4 clip = vec4(ndc, -1.0, 1.0);   // 裁剪空間座標
    vec4 eye = invViewProj * clip;      // 轉換到相機空間
    eye /= eye.w;                       // 齊次坐標歸一化
    return normalize(eye.xyz - camera.position);
}

vec3 trace_ray(Ray ray, float sampleIndex) {
    vec3 attenuation = WHITE;
    vec3 color = vec3(0.0);

    for (int depth = 0; depth < max_depth; depth++) {
        HitRecord hit;
        if (!hit_world(ray, hit)) {
            // // 背景色
            // float a = 0.5 * (ray.direction.y + 1.0);
            // vec3 sky = mix(WHITE, vec3(0.5, 0.7, 1.0), a);
            // color += attenuation * sky;
            color += attenuation;
            break;
        }
        Material material = hit.material;

        if (material.type == LIGHT) {
            float lightAttenuation = calculateAttenuation(hit.t);
            color += attenuation * hit.color * lightAttenuation;
            break;
        }

        // 玻璃
        if (material.type == GLASS) {
            float ior = material.ior;
            float eta = dot(ray.direction, hit.geoNormal) < 0.0 ? (1.0 / ior) : ior;
            ray.direction = refract(ray.direction, hit.shadingNormal, eta);
            attenuation *= max(vec3(0.8), hit.color) * 0.98;
        } else {
            // 漫反射 + 高光
            vec2 seed = hit.point.xy + float(depth) + sampleIndex;
            vec3 viewDir = -ray.direction;
            vec3 halfDir = cosine_weighted_direction(hit.shadingNormal, seed, hit.geoNormal);

            float specularChance = 0.05;
            if (random(seed + 2.0) < specularChance) {
                // 高光反射
                vec3 specularDir = reflect(viewDir, hit.shadingNormal);
                vec3 ggx = GGX_Specular(hit.shadingNormal, viewDir, specularDir, material.roughness, vec3(0.04));
                ray.direction = specularDir;
                attenuation *= ggx * hit.color;
            } else {
                // 漫反射
                ray.direction = halfDir;
                attenuation *= hit.color * 0.8;
            }
        }
        ray.origin = hit.point;
    }
    return color;
}

// ----------------------------------------------------
const int SAMPLES_PER_PIXEL = 1;
void main()
{
    // 取得像素座標
    vec2 pixel = gl_GlobalInvocationID.xy;
    // 邊界檢查
    if (pixel.x >= u_resolution.x || pixel.y >= u_resolution.y) return;

    vec3 color = vec3(0.0);

    for (int s = 0; s < SAMPLES_PER_PIXEL; s++) {
        vec2 jitter = random_vec2(pixel + float(s)) - 0.5;
        Ray ray;
        ray.origin = camera.position;
        ray.direction = getRayDir(pixel + jitter);
        color += trace_ray(ray, float(s));
    }
    // 平均多重採樣結果
    color /= float(SAMPLES_PER_PIXEL);
    imageStore(screenTexture, ivec2(pixel), vec4(color, 1.0));
}