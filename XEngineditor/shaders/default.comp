#version 460 core
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform writeonly image2D destTex;

uniform int triangleCount;
uniform vec2 u_resolution; 

// SSBO 相關定義 (保持不變)
struct Triangle { vec4 v0, v1, v2; };
layout(std430, binding = 3) buffer TriangleBuffer { Triangle triangles[]; };




// --- 新增 rayTriangleIntersect 函式 (你的版本) ---
float rayTriangleIntersect(vec3 rayOrigin, vec3 rayDir, vec3 v0, vec3 v1, vec3 v2) {
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 pvec = cross(rayDir, edge2);
    float det = dot(edge1, pvec);

    if (abs(det) < 0.00001) {
        return -1.0;
    }

    float invDet = 1.0 / det;
    vec3 tvec = rayOrigin - v0;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) {
        return -1.0;
    }

    vec3 qvec = cross(tvec, edge1);
    float v = dot(rayDir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) {
        return -1.0;
    }

    float t = dot(edge2, qvec) * invDet;
    return t;
}
// ----------------------------------------------------

void main()
{
    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    if (pixel_coords.x >= int(u_resolution.x) || pixel_coords.y >= int(u_resolution.y)) {
        return;
    }

    vec3 finalColor;

    // 使用固定的光線和三角形來測試 rayTriangleIntersect
    vec3 test_v0 = vec3(-1.0, -1.0, 0.0);
    vec3 test_v1 = vec3( 1.0, -1.0, 0.0);
    vec3 test_v2 = vec3( 0.0,  1.0, 0.0);
    
    vec3 test_rayOrigin = vec3(0.0, 0.0, 5.0); // 從 Z=5 射出
    vec3 test_rayDir = vec3(0.0, 0.0, -1.0);   // 朝著 -Z 方向

    float t = rayTriangleIntersect(test_rayOrigin, test_rayDir, test_v0, test_v1, test_v2);

    if (t > 0.0) {
        finalColor = vec3(0.0, 0.0, 1.0); // 藍色 (如果擊中)
    } else {
        finalColor = vec3(1.0, 0.0, 0.0); // 紅色 (如果未擊中)
    }

    imageStore(destTex, pixel_coords, vec4(finalColor, 1.0));
}