#version 460 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform writeonly image2D screenTexture;
layout(binding = 1) uniform sampler2D prevFrameTexture;

// SSBO 相關定義 (保持不變)
struct OBVHNode {
    vec4 aabbMin;
    vec4 aabbMax;
    ivec4 top;      // 最多4個子節點索引，-1表示無
    ivec4 bottom;   // 最多4個子節點索引，-1表示無
    ivec4 info;     // x=(1 leaf, -1 not leaf) , z=start, w=count
};

struct Camera {
    vec3 position;
    vec3 lookat;
    vec3 up;
    float fov;
};

struct Ray {
    vec3 origin;
    vec3 direction;
};

struct Material {
    vec4 baseColorFactor;         // 基礎顏色因子　　　16 bytes
    vec4 emissionFactor;          // 發光顏色或強度　　16 bytes
                                  
    float metallicFactor;         // 金屬度因子　　　　　4 bytes
    float roughnessFactor;        // 粗糙度因子　　　　　4 bytes
    float transmissionFactor;     // 透射率　　　　　　　4 bytes
    float ior;                    // 折射率　　　　　　　4 bytes

    int baseColorTexture;         // 基礎顏色紋理　　　　4 bytes 
    int metallicRoughnessTexture; // 金屬度與粗糙度紋理　4 bytes 
    int normalTexture;            // 法向量貼圖　　　　　4 bytes 
    int type;                     // 材質類型  　　　　　4 bytes  (0: PBR, 1: Light)
};

struct HitRecord {
    vec3 point;
    vec3 color;
    int materialID;
    float t;
    vec3 shadingNormal; 
    vec3 geoNormal;     
};

layout(std430, binding = 2) buffer OBVHNodeBuffer {
    OBVHNode obvhNodes[];
};

layout(std430, binding = 3) buffer VerticesBuffer {
    vec4 vertices[];
};

layout(std430, binding = 4) buffer IndicesBuffer {
    ivec4 indices[];
};

layout(std430, binding = 5) buffer GeoNormalsBuffer {
    vec4 geoNormals[];
};

layout(std430, binding = 6) buffer TexCoordsBuffer {
    vec2 texCoords[];
};

layout(std430, binding = 7) buffer MaterialIndicesBuffer {
    int materialIndices[];
};

layout(std430, binding = 8) buffer MaterialsBuffer {
    Material materials[];
};

layout(std430, binding = 9) buffer VertexNormalsBuffer {
    vec4 vertexNormals[];
};

layout(binding = 10) uniform sampler2D gPosition;
layout(binding = 11) uniform sampler2D gNormal;
layout(binding = 12) uniform sampler2D gAlbedoSpec;
layout(binding = 13) uniform sampler2D gEmission;


layout(binding = 20) uniform sampler2D u_textures[16]; 


uniform vec2 u_resolution;
uniform float u_time;
uniform Camera camera;
uniform bool cameraUpdated;

uniform mat4 invViewProj;
uniform int SAMPLES_PER_PIXEL;
uniform int MAX_DEPTH;
uniform vec3 backgroundColor;
uniform bool useOBVH;
// ------------------------------------------------

const float EPSILON = 1e-10;
const vec3 WHITE = vec3(1.0, 1.0, 1.0);
const float alpha = 0.05; // 混合係數

// 定義隨機數生成函數
uint hash( uint x ) {
    x += ( x << 10u );
    x ^= ( x >>  6u );
    x += ( x <<  3u );
    x ^= ( x >> 11u );
    x += ( x << 15u );
    return x;
}

uint hash( uvec2 v ) { return hash( v.x ^ hash(v.y)                         ); }
uint hash( uvec3 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z)             ); }
uint hash( uvec4 v ) { return hash( v.x ^ hash(v.y) ^ hash(v.z) ^ hash(v.w) ); }

float floatConstruct( uint m ) {
    const uint ieeeMantissa = 0x007FFFFFu;
    const uint ieeeOne      = 0x3F800000u;

    m &= ieeeMantissa;
    m |= ieeeOne;

    float  f = uintBitsToFloat( m );
    return f - 1.0;
}

float random( float x ) { return floatConstruct(hash(floatBitsToUint(x))); }
float random( vec2  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec3  v ) { return floatConstruct(hash(floatBitsToUint(v))); }
float random( vec4  v ) { return floatConstruct(hash(floatBitsToUint(v))); }

vec2 random_vec2(vec2 p) {
    return vec2(random(p), random(p + vec2(1.0, 0.0)));
}

vec3 random_color(vec2 co) {
    return vec3(random(co + vec2(1.0, 0.0)),
                random(co + vec2(0.0, 1.0)),
                random(co + vec2(1.0, 1.0)));
}

vec3 random_unit_vector(vec2 co) {
    float z = random(co) * 2.0 - 1.0; // z in [-1, 1]
    float t = random(co + vec2(1.0, 1.0)) * 6.28318530718; // t in [0, 2π]
    float r = sqrt(1.0 - z * z); // radius at z
    return normalize(vec3(r * cos(t), r * sin(t), z));
}

vec3 random_in_hemisphere(vec3 normal, vec2 seed) {
    vec3 in_unit = random_unit_vector(seed);
    return dot(in_unit, normal) > 0.0 ? in_unit : -in_unit;
}

vec3 cosine_weighted_direction(vec3 normal, vec2 seed, vec3 geoNormal) {
    // 餘弦加權分布
    const vec2 r = random_vec2(seed);
    const float phi = 2.0 * 3.14159265359 * r.x;
    const float cosTheta = sqrt(1.0 - r.y);
    const float sinTheta = sqrt(r.y);

    const vec3 tangent = normalize(abs(normal.x) > 0.1 ? cross(normal, vec3(0,1,0)) : cross(normal, vec3(1,0,0)));
    const vec3 bitangent = cross(normal, tangent);

    vec3 dir = cosTheta * normal +
               sinTheta * cos(phi) * tangent +
               sinTheta * sin(phi) * bitangent;
    dir = normalize(dir);

    return dot(dir, geoNormal) < 0.0 ? -dir : dir;
}

// GGX D項：Normal Distribution Function
float D_GGX(float NdotH, float roughness) {
    const float a = roughness * roughness;
    const float a2 = a * a;
    const float NdotH2 = NdotH * NdotH;
    const float denom = NdotH2 * (a2 - 1.0) + 1.0;
    return a2 / (3.14159265 * denom * denom);
}

// GGX G項：Geometry/Shadowing Term（Smith法）
float G_Smith(float NdotV, float NdotL, float roughness) {
    const float a = roughness * roughness;
    const float k = (a + 1.0) * (a + 1.0) / 8.0;
    const float G1V = NdotV / (NdotV * (1.0 - k) + k);
    const float G1L = NdotL / (NdotL * (1.0 - k) + k);
    return G1V * G1L;
}

// F項：Schlick近似的Fresnel
vec3 F_Schlick(float VdotH, vec3 F0) {
    return F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
}

// GGX Specular BRDF
vec3 GGX_Specular(vec3 normal, vec3 viewDir, vec3 lightDir, float roughness, vec3 F0) {
    const vec3 halfDir = normalize(viewDir + lightDir);
    const float NdotL = max(dot(normal, lightDir), 0.0);
    const float NdotV = max(dot(normal, viewDir), 0.0);
    const float NdotH = max(dot(normal, halfDir), 0.0);
    const float VdotH = max(dot(viewDir, halfDir), 0.0);

    const float D = D_GGX(NdotH, roughness);
    const float G = G_Smith(NdotV, NdotL, roughness);
    const vec3 F = F_Schlick(VdotH, F0);

    return (D * G * F) / (4.0 * NdotL * NdotV + 0.001);
}

// 區域光源採樣函式
vec3 sample_area_light(vec3 lightCenter, float lightRadius, vec2 seed) {
    const float z = random(seed) * 2.0 - 1.0;
    const float phi = 2.0 * 3.14159265359 * random(seed + 1.0);
    const float r = sqrt(1.0 - z * z);
    const vec3 dir = vec3(r * cos(phi), r * sin(phi), z);
    return lightCenter + lightRadius * dir;
}

vec3 sample_rect_light(vec3 center, vec3 normal, float size, vec2 seed) {
    vec3 tangent = normalize(abs(normal.x) > 0.1 ? cross(normal, vec3(0,1,0)) : cross(normal, vec3(1,0,0)));
    vec3 bitangent = cross(normal, tangent);
    float u = random(seed) - 0.5;
    float v = random(seed + 1.0) - 0.5;
    return center + (u * size) * tangent + (v * size) * bitangent;
}

// ------------------------------------------------
// 材質類型常數
const int PBR   = 0;
const int LIGHT = 1;



// 輔助函數：獲取基礎顏色 (混合紋理與因子)
vec3 getBaseColor(Material mat, vec2 uv) {
    vec3 color = mat.baseColorFactor.rgb;
    
    if (mat.baseColorTexture >= 0) {
        // 限制索引範圍，防止越界
        int texID = min(mat.baseColorTexture, 15); 
        // 注意：這裡假設 sampler2D u_textures 已經正確綁定
        color *= texture(u_textures[texID], uv).rgb;
    }
    return color;
}

// ------------------------------------------------
// 計算光線衰減函式
float calculateAttenuation(float dist) {
    // 調整衰減參數，讓光線衰減更慢
    float constant = 1.0;
    float linear = 0.02;     // 0.02, 0.09
    float quadratic = 0.005; // 0.005, 0.032
    return 1.0 / (constant + linear * dist + quadratic * dist * dist);
}

vec3 barycentric(vec3 n0, vec3 n1, vec3 n2, float u, float v) {
    float w = 1.0 - u - v;
    return normalize(n0 * w + n1 * u + n2 * v);
}

vec3 quadratic(vec3 n0, vec3 n1, vec3 n2, float u, float v) {
    float w = 1.0 - u - v;
    // 二次重心基底
    float uu = u * u;
    float vv = v * v;
    float ww = w * w;
    float uv = u * v;
    float uw = u * w;
    float vw = v * w;
    // 可調整權重，這裡用常見的二次重心插值
    return normalize(
        n0 * ww +
        n1 * uu +
        n2 * vv +
        2.0 * (n0 * uw + n1 * uv + n2 * vw)
    );
}

// --- 新增 intersectTriangle 函式 (你的版本) ---
// Möller–Trumbore 演算法
vec3 intersectTriangle(Ray ray, vec3 p0, vec3 p1, vec3 p2) {
    const vec3 edge1 = p1 - p0;
    const vec3 edge2 = p2 - p0;
    const vec3 pvec = cross(ray.direction, edge2);
    const float det = dot(edge1, pvec);

    if (abs(det) < 1e-5) return vec3(-1.0);

    const float invDet = 1.0 / det;
    const vec3 tvec = ray.origin - p0;
    const float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return vec3(-1.0);

    const vec3 qvec = cross(tvec, edge1);
    const float v = dot(ray.direction, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) return vec3(-1.0);

    const float t = dot(edge2, qvec) * invDet;

    if (t < EPSILON) return vec3(-1.0);
    return vec3(t, u, v);
}
// ------------------------------------------------
// --- 新增 hit_qbvh 函式 ---
bool aabb_hit(Ray ray, vec3 minB, vec3 maxB, float tMax) {
    const vec3 invD = 1.0 / ray.direction;
    const vec3 t0 = (minB - ray.origin) * invD;
    const vec3 t1 = (maxB - ray.origin) * invD;

    const vec3 tmin = min(t0, t1);
    const vec3 tmax = max(t0, t1);

    const float entry = max(max(tmin.x, tmin.y), tmin.z);
    const float exit  = min(min(tmax.x, tmax.y), tmax.z);

    return exit >= max(entry, 0.0) && entry < tMax;
}


bool hit_obvh_leaf(Ray ray, int i, inout float tMax, out vec3 hitResult) {
    const bool doubleSided = false;
    const ivec4 index = indices[i];
    const vec3 p0 = vertices[index.x].xyz;
    const vec3 p1 = vertices[index.y].xyz;
    const vec3 p2 = vertices[index.z].xyz;
    const vec3 tempHitResult = intersectTriangle(ray, p0, p1, p2);
    const float t = tempHitResult.x;

    const bool hitSomething = t < tMax && (doubleSided || t > EPSILON);
    if (hitSomething) {
        tMax = t;
        hitResult = tempHitResult;
        return true;
    } else {
        return false;
    }
}

int hit_obvh(Ray ray, out vec3 hitResult) {
    float tMax = 1e9;
    int hitIdx = -1;

    int stack[128];
    int stackPtr = 0;
    stack[stackPtr++] = 0; // root node

    while (stackPtr > 0) {
        if (tMax < EPSILON) break;
        int nodeIdx = stack[--stackPtr];
        OBVHNode node = obvhNodes[nodeIdx];

        if (!aabb_hit(ray, node.aabbMin.xyz, node.aabbMax.xyz, tMax)) {
            continue;
        }

        const bool isLeaf = (node.info.x == 1);

        if (isLeaf) {
            // 處理葉節點中的所有三角形
            const int start = node.info.z;
            const int count = node.info.w;
            for (int i = start; i < start + count; i++) 
            {   
                vec3 tempHitResult;
                if (hit_obvh_leaf(ray, i, tMax, tempHitResult)) 
                {
                    hitIdx = i;
                    hitResult = tempHitResult;
                }
            }
        } else {
            const ivec4 top = node.top;
            const ivec4 bottom = node.bottom;
            if (top.x >= 0) stack[stackPtr++] = top.x;
            if (top.y >= 0) stack[stackPtr++] = top.y;
            if (top.z >= 0) stack[stackPtr++] = top.z;
            if (top.w >= 0) stack[stackPtr++] = top.w;
            if (bottom.x >= 0) stack[stackPtr++] = bottom.x;
            if (bottom.y >= 0) stack[stackPtr++] = bottom.y;
            if (bottom.z >= 0) stack[stackPtr++] = bottom.z;
            if (bottom.w >= 0) stack[stackPtr++] = bottom.w;
        }
    }
    return hitIdx;
}

int hit_triangle(Ray ray, out vec3 hitResult) {
    float tMax = 1e9;
    int hitIdx = -1;

    for (int i = 0; i < indices.length(); i++) {
        const ivec4 index = indices[i];
        const vec3 p0 = vertices[index.x].xyz;
        const vec3 p1 = vertices[index.y].xyz;
        const vec3 p2 = vertices[index.z].xyz;

        const vec3 tempHitResult = intersectTriangle(ray, p0, p1, p2);
        const float t = tempHitResult.x;

        if (t < tMax && t > EPSILON) {
            tMax = t;
            hitIdx = i;
            hitResult = tempHitResult;
        }
    }
    return hitIdx;
}

bool hit_world(Ray ray, out HitRecord hit) {
    vec3 hitResult;
    int hitIdx = useOBVH ? hit_obvh(ray, hitResult) : hit_triangle(ray, hitResult);
    if (hitIdx == -1) return false;

    const ivec4 index = indices[hitIdx];
    const vec3 p0 = vertices[index.x].xyz;
    const vec3 p1 = vertices[index.y].xyz;
    const vec3 p2 = vertices[index.z].xyz;
    
    const float t = hitResult.x;
    const float u = hitResult.y;
    const float v = hitResult.z;
    hit.t = t;
    hit.point = ray.origin + hit.t * ray.direction;

    const vec3 n0 = vertexNormals[index.x].xyz;
    const vec3 n1 = vertexNormals[index.y].xyz;
    const vec3 n2 = vertexNormals[index.z].xyz;

    const vec3 geoNormal = geoNormals[hitIdx].xyz;
    // vec3 normal = quadratic(n0, n1, n2, u, v);
    const vec3 normal = barycentric(n0, n1, n2, u, v);
    const bool geo_frontFace = dot(ray.direction, geoNormal) < 0.0;
    const bool frontFace = dot(geoNormal, normal) > 0.0;

    hit.geoNormal = geo_frontFace ? geoNormal : -geoNormal;
    hit.shadingNormal = frontFace ? normal : -normal;

    // --- [關鍵修改] 材質讀取 ---
    // 1. 從 SSBO 獲取 ID
    int matID = materialIndices[hitIdx];
    hit.materialID = matID;

    // 2. 獲取具體材質數據
    Material mat = materials[matID];

    // 3. 計算 UV
    const vec2 uv0 = texCoords[index.x];
    const vec2 uv1 = texCoords[index.y];
    const vec2 uv2 = texCoords[index.z];
    vec2 hitUV = uv0 * (1.0 - u - v) + uv1 * u + uv2 * v;

    // 4. 計算並儲存顏色 (這樣 trace_ray 不用再算一次紋理)
    hit.color = getBaseColor(mat, hitUV);

    return true;
}

vec3 getRayDir(vec2 pixel)
{
    // 光線生成
    const vec2 ndc = (pixel + vec2(0.5)) / u_resolution * 2.0 - 1.0; // 正規化裝置座標
    const vec4 clip = vec4(ndc, -1.0, 1.0);   // 裁剪空間座標
    vec4 eye = invViewProj * clip;      // 轉換到相機空間
    eye /= eye.w;                       // 齊次坐標歸一化
    return normalize(eye.xyz - camera.position);
}

vec3 trace_ray(Ray ray, float sampleIndex) {
    vec3 rayColor = WHITE;
    vec3 brightness_score = vec3(0.0);

    for (int depth = 0; depth < MAX_DEPTH; depth++) {
        HitRecord hit;
        if (!hit_world(ray, hit)) {
            // // 背景色
            // float a = 0.5 * (ray.direction.y + 1.0);
            // vec3 sky = mix(WHITE, vec3(0.5, 0.7, 1.0), a);
            // color += attenuation * sky;
            break;
        }

        // 從 SSBO 讀取材質屬性
        Material material = materials[hit.materialID];

        // 1. 處理光源 (Emission)
        // 無論是 Light Type 還是 PBR 物件有自發光，都加上去
        if (material.type == LIGHT || length(material.emissionFactor.rgb) > 0.0)
        {
            float lightAttenuation = calculateAttenuation(hit.t);
            // emissionFactor.a 可以當作強度 multiplier
            vec3 emission = material.emissionFactor.rgb * material.emissionFactor.a;
            
            // 只有當面朝向我們時才看到光 (單面光)
            if (dot(hit.geoNormal, ray.direction) < 0.0) {
                 brightness_score += rayColor * emission * lightAttenuation;
            }
            
            // 如果是純光源類型，停止反彈
            if (material.type == LIGHT) break; 
        }

        // 2. 處理透射 (Transmission / Glass)
        if (material.transmissionFactor > 0.0)
        {
            float ior = material.ior;
            float eta = dot(ray.direction, hit.geoNormal) < 0.0 ? (1.0 / ior) : ior;
            
            vec3 bias = hit.geoNormal * 1e-4; // 偏移量
            vec3 refracted = refract(ray.direction, hit.shadingNormal, eta);
            
            // 簡單處理：如果發生全反射 (Total Internal Reflection)，refract 返回 0
            if (length(refracted) == 0.0) {
                ray.direction = reflect(ray.direction, hit.shadingNormal);
                ray.origin = hit.point + bias;
            } else {
                // 這裡可以使用 Fresnel 混合反射和折射，這裡簡化為根據 transmission 機率決定
                // 或者簡單地直接折射
                ray.direction = refracted;
                ray.origin = hit.point - bias; // 折射起始點在物體內部/另一側
            }
            
            rayColor *= hit.color; // 玻璃顏色
        }
        // 3. 處理不透明物體 (PBR: Diffuse + Specular)
        else
        {
            vec2 seed = hit.point.xy + float(depth) + sampleIndex;
            vec3 viewDir = -ray.direction;
            
            // 基礎 F0 反射率 (非金屬 0.04，金屬則是 baseColor)
            vec3 F0 = vec3(0.04); 
            F0 = mix(F0, hit.color, material.metallicFactor);

            // 簡單的 GGX 採樣策略
            // 這裡我們用一個隨機數決定是走 Specular 還是 Diffuse
            // 實際 PBR 應該使用重要性採樣 (Importance Sampling)
            
            // 金屬度越高，漫反射越少
            float metallic = material.metallicFactor;
            float roughness = material.roughnessFactor;

            // 決定反射機率 (Fresnel 近似)
            float specularProb = mix(0.04, 1.0, metallic); 
            
            if (random(seed + 1.3) < specularProb) {
                // === Specular path ===
                vec3 reflected = reflect(ray.direction, hit.shadingNormal);
                // 根據 roughness 擾動反射方向
                vec3 jitter = random_unit_vector(seed) * roughness;
                ray.direction = normalize(reflected + jitter);
                
                // 確保不射入表面內部
                if (dot(ray.direction, hit.geoNormal) <= 0.0) ray.direction = reflected;

                // 簡單能量補償
                rayColor *= mix(vec3(1.0), hit.color, metallic); 
            } 
            else {
                // === Diffuse path ===
                ray.direction = cosine_weighted_direction(hit.shadingNormal, seed, hit.geoNormal);
                // 金屬幾乎不吸收漫反射顏色，非金屬則顯示 baseColor
                rayColor *= hit.color * (1.0 - metallic);
            }
            
            ray.origin = hit.point + hit.geoNormal * 1e-4;
        }
    }
    return brightness_score;
}

vec3 trace_ray_deferred(vec2 uv, vec2 seed, float sampleIndex) {
    
    // 1. [Depth 0] 讀取 G-Buffer
    vec4 posData = texture(gPosition, uv);
    vec4 normData = texture(gNormal, uv);
    vec4 albedoData = texture(gAlbedoSpec, uv);
    vec4 emissionData = texture(gEmission, uv);

    // 檢查 Alpha (0.0 = Background)
    if (posData.w == 0.0) {
        return backgroundColor;
    }

    // 構建第一擊的 HitRecord
    HitRecord hit;
    hit.point = posData.xyz;
    hit.shadingNormal = normData.xyz;
    hit.geoNormal = normData.xyz; // GBuffer 近似值
    hit.color = albedoData.rgb;
    hit.t = 0.0; 
    
    float roughness = normData.w;
    float metallic = albedoData.w;
    vec3 emission = emissionData.rgb;

    // 初始化光線顏色 (自發光)
    vec3 rayColor = emission;
    vec3 throughput = vec3(1.0);

    // 準備發射次級光線 (Reflection/Refraction/GI)
    Ray ray;
    vec3 viewDir = normalize(camera.position - hit.point); 
    
    // PBR 採樣策略 (與之前相同)
    vec3 F0 = vec3(0.04); 
    F0 = mix(F0, hit.color, metallic);
    float specularProb = mix(0.04, 1.0, metallic);
    
    // 隨機決定 Diffuse 或 Specular
    bool isSpecular = random(seed) < specularProb;

    if (isSpecular) {
        vec3 reflected = reflect(-viewDir, hit.shadingNormal);
        vec3 jitter = random_unit_vector(seed) * roughness;
        ray.direction = normalize(reflected + jitter);
        
        if(dot(ray.direction, hit.geoNormal) <= 0.0) ray.direction = reflected;
        
        throughput *= mix(vec3(1.0), hit.color, metallic);
    } else {
        ray.direction = cosine_weighted_direction(hit.shadingNormal, seed, hit.geoNormal);
        throughput *= hit.color * (1.0 - metallic); 
    }
    
    ray.origin = hit.point + hit.geoNormal * 1e-3;

    // 2. [Depth 1 to MAX] 次級光線循環
    for (int depth = 1; depth < MAX_DEPTH; depth++) {
        HitRecord nextHit;
        
        // 使用 BVH 進行光線求交
        if (!hit_world(ray, nextHit)) {
            // 擊中天空
            rayColor += throughput * backgroundColor; 
            break;
        }

        // 讀取材質
        Material mat = materials[nextHit.materialID];
        
        // 累積發光
        vec3 nextEmission = mat.emissionFactor.rgb * mat.emissionFactor.a; // alpha 作為強度
        if (dot(nextHit.geoNormal, ray.direction) < 0.0) {
            rayColor += throughput * nextEmission;
        }
        
        if (mat.type == 1) break; // Light type

        // 更新隨機種子
        seed += float(depth);
        
        float nextMetallic = mat.metallicFactor;
        // float nextRoughness = mat.roughnessFactor; // 暫時未用
        
        // 簡單 Diffuse Bounce (可擴充為完整 PBR)
        vec3 nextDir = cosine_weighted_direction(nextHit.shadingNormal, seed, nextHit.geoNormal);
        
        throughput *= nextHit.color * (1.0 - nextMetallic); 
        
        // 更新光線
        ray.origin = nextHit.point + nextHit.geoNormal * 1e-3;
        ray.direction = nextDir;
        
        // 俄羅斯輪盤賭
        if (depth > 2) {
            float p = max(throughput.r, max(throughput.g, throughput.b));
            if (random(seed + 0.5) > p) break;
            throughput /= p;
        }
    }

    return rayColor;
}

// ----------------------------------------------------
void main()
{
    // 取得像素座標
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    // 邊界檢查
    if (pixel.x >= int(u_resolution.x) || pixel.y >= int(u_resolution.y)) return;

    vec3 color = vec3(0.0);
    const float ran = random(u_time);

    for (int s = 0; s < SAMPLES_PER_PIXEL; s++) {
        const vec2 jitter = random_vec2(pixel + float(s) + ran) - 0.5;
        Ray ray;
        ray.origin = camera.position;
        ray.direction = getRayDir(pixel + jitter);
        color += trace_ray(ray, float(s));
    }
    // 平均多重採樣結果
    color /= float(SAMPLES_PER_PIXEL);

    // 若相機靜止，讀取上一幀顏色並混合
    if (!cameraUpdated) {
        const vec3 prevColor = texture(prevFrameTexture, (pixel + 0.5) / u_resolution).rgb;
        color = mix(prevColor, color, alpha);
    }

    imageStore(screenTexture, pixel, vec4(color, 1.0));
}