vec3 getRayDir(vec2 pixel)
{
    // 光線生成
    vec2 ndc = (pixel + vec2(0.5)) / u_resolution * 2.0 - 1.0; // 正規化裝置座標
    vec4 clip = vec4(ndc, -1.0, 1.0);   // 裁剪空間座標
    vec4 eye = invViewProj * clip;      // 轉換到相機空間
    eye /= eye.w;                       // 齊次坐標歸一化
    return normalize(eye.xyz - camera.position);
}
// ----------------------------------------------------
const int SAMPLES_PER_PIXEL = 9;
void main()
{
    // 取得像素座標
    vec2 pixel = gl_GlobalInvocationID.xy;
    // 邊界檢查
    if (pixel.x >= u_resolution.x || pixel.y >= u_resolution.y) return;
    
    vec3 color = vec3(0.0);
    
    for (int s = 0; s < SAMPLES_PER_PIXEL; ++s) {
        // 隨機偏移像素座標
        vec2 jitter = random_vec2(pixel + float(s)) - 0.5;
        vec2 samplePixel = pixel + jitter;

        Ray ray;
        ray.origin = camera.position;
        ray.direction = getRayDir(samplePixel);

        vec3 attenuation = WHITE;
        float t = 0.0;
        for (int depth = 0; depth < 10; depth++) {
            HitRecord rec;
            if (!hit_world(ray, rec)) {
                color += attenuation;
                break;
            }
            t += rec.t;

            // 確保着色法線和幾何法線都朝向光線來源方向，防止 "terminator problem"
            vec3 outward_geo_normal = faceforward(rec.geoNormal, ray.direction, rec.geoNormal);
            vec3 shading_normal = faceforward(rec.shadingNormal, ray.direction, rec.shadingNormal);

            // 如果修正後的着色法線與幾何法線方向不一致（不在同一個半球），則需要進一步修正。
            // 這裡我們採用文章中的思想，確保着色法線位於幾何法線定義的半球內。
            if (dot(shading_normal, outward_geo_normal) < 0.0) {
                // 將 shading_normal 翻轉到 outward_geo_normal 的半球
                shading_normal = reflect(shading_normal, outward_geo_normal);
            }

             // --- 材質處理 ---
            if (rec.material.type == LIGHT) {
                float lightAttenuation = calculateAttenuation(t);
                color += attenuation * rec.color * lightAttenuation;
                break;
            } 
            
            vec3 next_direction;
            if (rec.material.type == GLASS) {
                float ior = rec.material.ior;
                // 判斷是進入還是離開物體，應基於幾何法線
                bool entering = dot(ray.direction, outward_geo_normal) < 0.0;
                float eta = entering ? (1.0 / ior) : ior;
                vec3 N = entering ? shading_normal : -shading_normal;
                
                next_direction = refract(ray.direction, N, eta);
                // 處理全反射
                if (dot(next_direction, next_direction) == 0.0) {
                    next_direction = reflect(ray.direction, N);
                }
                attenuation *= max(vec3(0.8), rec.color) * 0.98;

            } else { // DIFFUSE / TEXTURE
                vec3 diffuseDir = random_in_hemisphere(shading_normal, rec.pos.xy + float(depth) + float(s));
                vec3 specularDir = reflect(ray.direction, shading_normal);
                next_direction = normalize(mix(diffuseDir, specularDir, rec.material.roughness));
                attenuation *= rec.color * 0.8;
            }
            
            // --- 【修改 3.2】BSDF 半球一致性修正 ---
            // 根據文章 15.2.2，確保新的反射/折射方向位於幾何法線的正半球
            if (dot(next_direction, outward_geo_normal) < EPSILON) {
                // 如果方向“鑽入”了物體表面，將其沿幾何法線反射回正確的半球
                // 這直接對應文章中的 r = r - 2 * r.dot(geo_normal) * geo_normal
                // reflect(I, N) = I - 2.0 * dot(I, N) * N
                // 我們需要的是將其翻轉，所以是 -reflect(next_direction, outward_geo_normal)
                // 或者更直接地：
                next_direction = next_direction - 2.0 * dot(next_direction, outward_geo_normal) * outward_geo_normal;
            }

            ray.direction = next_direction;
            ray.origin = rec.pos + ray.direction * EPSILON;
        }
    }
    color /= float(SAMPLES_PER_PIXEL);
    imageStore(screenTexture, ivec2(pixel), vec4(pow(color, vec3(1.0/2.2)), 1.0));

}